            lines {
              text: "   - K\303\244ytt\303\244j\303\244 avaa Field Service -skinin ja n\303\244kee t\303\244m\303\244n p\303\244iv\303\244n 3 ty\303\266tilausta."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE

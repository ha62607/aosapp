  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n * AOS Product v0.1 \342\200\224 Automated Verification & Boundary Test Suite\n */\n\nimport { DEFAULT_SKINS } from \'../data/defaultSkins\';\nimport {\n  interpretUserIntent,\n  approveProposal,\n  rejectProposal,\n  getExperienceConfig,\n  saveExperienceConfig,\n  switchActiveDevice,\n  getDevices,\n} from \'../services/aosApi\';\n\nasync function runTestSuite() {\n  console.log(\'--- Aloitetaan AOS Product v0.1 -testit ---\');\n  let passed = 0;\n  let total = 0;\n\n  function assert(condition: boolean, msg: string) {\n    total++;\n    if (!condition) {\n      console.error(`\342\235\214 FAIL: ${msg}`);\n      throw new Error(`Test failed: ${msg}`);\n    }\n    console.log(`\342\234\205 PASS: ${msg}`);\n    passed++;\n  }\n\n  // Test 1: Declarative Skin Manifest Schema Validation\n  for (const skin of DEFAULT_SKINS) {\n    assert(skin.schema_version === \'aos.skin.v0.1\', `${skin.skin_id} noudattaa aos.skin.v0.1 -skeemaa`);\n    assert(Array.isArray(skin.required_capabilities), `${skin.skin_id} m\303\244\303\244rittelee tarvittavat kyvykkyydet`);\n    assert(skin.views.length >= 2, `${skin.skin_id} sis\303\244lt\303\244\303\244 v\303\244hint\303\244\303\244n 2-3 n\303\244kym\303\244\303\244`);\n\n    // Ensure all widgets belong to allowlisted component types\n    const allowedTypes = [\n      \'metric-group\',\n      \'record-list\',\n      \'intent-composer\',\n      \'activity-list\',\n      \'route-display\',\n      \'notes-board\',\n    ];\n    for (const widget of skin.widgets) {\n      assert(\n        allowedTypes.includes(widget.component_type),\n        `Widget ${widget.id} k\303\244ytt\303\244\303\244 sallittua tyyppi\303\244: ${widget.component_type}`\n      );\n    }\n  }\n\n  // Test 2: Intent -> Proposal -> Reject (Zero Mutation Guarantee)\n  const proposal1 = await interpretUserIntent(\'Prepare a plan for tomorrow\\\'s three service visits\', \'field-service-demo\');\n  assert(proposal1.requires_human_approval === true, \'Ehdotus vaatii aina ihmisen hyv\303\244ksynn\303\244n\');\n  assert(proposal1.status === \'draft\', \'Ehdotus luodaan luonnostilassa (draft)\');\n  assert(proposal1.proposed_steps.length > 0, \'Ehdotus sis\303\244lt\303\244\303\244 j\303\244sennellyt vaiheet\');\n\n  const rejectRes = await rejectProposal(proposal1.id);\n  assert(rejectRes.proposal.status === \'rejected\', \'Hylk\303\244ys lukitsee tilan tilaan \"rejected\"\');\n  assert(rejectRes.proposal.evidence?.includes(\'Nolla mutaatiota\'), \'Evidenssi vahvistaa nollamutaation\');\n\n  // Test 3: Intent -> Edit Steps -> Approve (plan_only Execution)\n  const proposal2 = await interpretUserIntent(\'Optimoi reitti Keimolanportin kautta\', \'driver-demo\');\n  const editedSteps = [...proposal2.proposed_steps];\n  editedSteps[0].title = \'Mukautettu vaihe: Tarkista Keh\303\244 I\';\n  const approveRes = await approveProposal(proposal2.id, editedSteps);\n  assert(approveRes.proposal.status === \'approved\', \'Hyv\303\244ksynt\303\244 siirt\303\244\303\244 tilan tilaan \"approved\"\');\n  assert(approveRes.evidence.includes(\'completed\'), \'Kanoninen mcp-teht\303\244v\303\244tila on \"completed\"\');\n\n  // Test 4: Experience Customization & Versioning\n  const config = await getExperienceConfig(\'field-service-demo\');\n  const initialVersion = config.version;\n  const updatedConfig = await saveExperienceConfig({\n    ...config,\n    display_name: \'Customized Field Service\',\n  });\n  assert(updatedConfig.version === initialVersion + 1, \'Kokoonpanon versio inkrementoituu tallennuksessa\');\n  assert(updatedConfig.display_name === \'Customized Field Service\', \'Mukautettu nimi tallentuu\');\n\n  // Test 5: Multi-Device Synchronization on Single Account\n  const initialDevices = await getDevices();\n  assert(initialDevices.length >= 3, \'Tilill\303\244 on v\303\244hint\303\244\303\244n 3 valtuutettua laitetta\');\n  const tablet = initialDevices.find((d) => d.type === \'tablet\');\n  assert(!!tablet, \'Tabletti l\303\266ytyy valtuutetuista laitteista\');\n  await switchActiveDevice(tablet!.id);\n  const afterSwitch = await getDevices();\n  const current = afterSwitch.find((d) => d.id === tablet!.id);\n  assert(current?.is_current === true, \'Aktiivisen laitteen konteksti vaihtuu onnistuneesti\');\n\n  console.log(`\\n\360\237\216\211 Kaikki ${passed}/${total} testi\303\244 l\303\244p\303\244isty onnistuneesti!`);\n}\n\nrunTestSuite().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n"
        path {
          absolute_uri: "file:///src/tests/aos.test.ts"
        }
        overwrite: true
      }
    }

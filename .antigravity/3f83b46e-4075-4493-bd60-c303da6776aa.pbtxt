        replacement_chunks {
          target_content: "interface SkinLibraryViewProps {\n  skins: SkinManifest[];\n  activeSkin: SkinManifest;\n  onActivateSkin: (skinId: string) => void;\n  onToggleInstall: (skinId: string, install: boolean) => void;\n  onOpenCustomizer: (skin: SkinManifest) => void;\n}\n\nexport const SkinLibraryView: React.FC<SkinLibraryViewProps> = ({\n  skins,\n  activeSkin,\n  onActivateSkin,\n  onToggleInstall,\n  onOpenCustomizer,\n}) => {\n  const [filter, setFilter] = useState<\'all\' | \'installed\' | \'demo\'>(\'all\');\n\n  const filteredSkins = skins.filter((skin) => {\n    if (filter === \'installed\') return skin.installed;\n    if (filter === \'demo\') return skin.kind === \'demo\';\n    return true;\n  });\n\n  const getSkinIcon = (iconName: string) => {\n    switch (iconName) {\n      case \'Wrench\':\n        return <Wrench className=\"w-5 h-5 text-teal-500\" />;\n      case \'Navigation\':\n        return <Navigation className=\"w-5 h-5 text-orange-500\" />;\n      default:\n        return <Sparkles className=\"w-5 h-5 text-indigo-500\" />;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center gap-2 mb-1\">\n              <Layers className=\"w-5 h-5 text-indigo-600 dark:text-indigo-400\" />\n              <h2 className=\"font-display font-bold text-lg sm:text-xl text-slate-900 dark:text-white\">\n                Skin Library & Pakatut kokemukset\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed\">\n              *Skin* ei ole vain v\303\244riteema, vaan pakattu toimialakokemus: k\303\244ytt\303\266tarkoituksen mukainen\n              sanasto, ty\303\266nkulut, widgetit, luvat ja rajapinnat. Kaikki jakavat saman AOS Engine -moottorin.\n            </p>\n          </div>\n\n          {/* Segmented Filter */}\n          <div className=\"flex items-center gap-1 p-1 bg-slate-100 dark:bg-slate-800 rounded-xl self-start sm:self-auto text-xs font-medium\">\n            <button\n              onClick={() => setFilter(\'all\')}\n              className={`px-3 py-1.5 rounded-lg transition-colors ${\n                filter === \'all\'\n                  ? \'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900\'\n              }`}\n            >\n              Kaikki ({skins.length})\n            </button>\n            <button\n              onClick={() => setFilter(\'installed\')}\n              className={`px-3 py-1.5 rounded-lg transition-colors ${\n                filter === \'installed\'\n                  ? \'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900\'\n              }`}\n            >\n              Asennetut ({skins.filter((s) => s.installed).length})\n            </button>\n            <button\n              onClick={() => setFilter(\'demo\')}\n              className={`px-3 py-1.5 rounded-lg transition-colors ${\n                filter === \'demo\'\n                  ? \'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900\'\n              }`}\n            >\n              Demot\n            </button>\n          </div>\n        </div>\n      </div>"
          replacement_content: "interface SkinLibraryViewProps {\n  skins: SkinManifest[];\n  activeSkin: SkinManifest;\n  onActivateSkin: (skinId: string) => void;\n  onToggleInstall: (skinId: string, install: boolean) => void;\n  onOpenCustomizer: (skin: SkinManifest) => void;\n  onOpenStudio?: () => void;\n}\n\nexport const SkinLibraryView: React.FC<SkinLibraryViewProps> = ({\n  skins,\n  activeSkin,\n  onActivateSkin,\n  onToggleInstall,\n  onOpenCustomizer,\n  onOpenStudio,\n}) => {\n  const [filter, setFilter] = useState<\'all\' | \'installed\' | \'demo\'>(\'all\');\n\n  const filteredSkins = skins.filter((skin) => {\n    if (filter === \'installed\') return skin.installed;\n    if (filter === \'demo\') return skin.kind === \'demo\';\n    return true;\n  });\n\n  const getSkinIcon = (iconName: string) => {\n    switch (iconName) {\n      case \'Wrench\':\n        return <Wrench className=\"w-5 h-5 text-teal-500\" />;\n      case \'Navigation\':\n        return <Navigation className=\"w-5 h-5 text-orange-500\" />;\n      default:\n        return <Sparkles className=\"w-5 h-5 text-indigo-500\" />;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Info */}\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-5 sm:p-6 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center gap-2 mb-1\">\n              <Layers className=\"w-5 h-5 text-indigo-600 dark:text-indigo-400\" />\n              <h2 className=\"font-display font-bold text-lg sm:text-xl text-slate-900 dark:text-white\">\n                Skin Library & Pakatut kokemukset\n              </h2>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-2xl leading-relaxed\">\n              *Skin* ei ole vain v\303\244riteema, vaan pakattu toimialakokemus: k\303\244ytt\303\266tarkoituksen mukainen\n              sanasto, ty\303\266nkulut, widgetit, luvat ja rajapinnat. Kaikki jakavat saman AOS Engine -moottorin.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            {onOpenStudio && (\n              <button\n                onClick={onOpenStudio}\n                className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-xs transition-colors\"\n              >\n                <Sparkles className=\"w-4 h-4 text-indigo-200\" />\n                <span>Avaa Skin Studio</span>\n              </button>\n            )}\n\n            {/* Segmented Filter */}\n            <div className=\"flex items-center gap-1 p-1 bg-slate-100 dark:bg-slate-800 rounded-xl text-xs font-medium\">\n              <button\n                onClick={() => setFilter(\'all\')}\n                className={`px-3 py-1.5 rounded-lg transition-colors ${\n                  filter === \'all\'\n                    ? \'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs\'\n                    : \'text-slate-600 dark:text-slate-400 hover:text-slate-900\'\n                }`}\n              >\n                Kaikki ({skins.length})\n              </button>\n              <button\n                onClick={() => setFilter(\'installed\')}\n                className={`px-3 py-1.5 rounded-lg transition-colors ${\n                  filter === \'installed\'\n                    ? \'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs\'\n                    : \'text-slate-600 dark:text-slate-400 hover:text-slate-900\'\n                }`}\n              >\n                Asennetut ({skins.filter((s) => s.installed).length})\n              </button>\n              <button\n                onClick={() => setFilter(\'demo\')}\n                className={`px-3 py-1.5 rounded-lg transition-colors ${\n                  filter 
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n * AOS Product v0.1 \342\200\224 Realistic Mock Fixtures (Explicitly Tagged DEMO)\n */\n\nimport { AOSAccount, AOSDevice, ActivityEvent } from \'../types/aos\';\n\nexport const INITIAL_ACCOUNT: AOSAccount = {\n  id: \'acc_hannu_primus72\',\n  name: \'Hannu (Primus72)\',\n  email: \'hannu@primus72.com\',\n  tenant_id: \'tenant_primus_eu1\',\n  plan: \'Professional\',\n  status: \'active\',\n  created_at: \'2026-09-01T08:00:00Z\',\n  monthly_token_usage: 14250,\n  monthly_token_limit: 100000,\n};\n\nexport const INITIAL_DEVICES: AOSDevice[] = [\n  {\n    id: \'dev_phone_9pro\',\n    name: \'Pixel 9 Pro (T\303\244m\303\244 laite)\',\n    type: \'mobile_phone\',\n    platform: \'Android PWA / Chrome 132\',\n    authorized_at: \'2026-10-15T09:30:00Z\',\n    last_seen: \'Juuri nyt\',\n    status: \'active\',\n    is_current: true,\n    permitted_capabilities: [\'ai.chat\', \'tasks.plan_only\', \'notes.storage\', \'jobs.sample.read\'],\n  },\n  {\n    id: \'dev_tablet_air\',\n    name: \'iPad Air 11\" (Huoltoauto / Toimisto)\',\n    type: \'tablet\',\n    platform: \'iPadOS PWA / Safari\',\n    authorized_at: \'2026-10-18T14:10:00Z\',\n    last_seen: \'12 min sitten\',\n    status: \'standby\',\n    is_current: false,\n    permitted_capabilities: [\'ai.chat\', \'tasks.plan_only\', \'notes.storage\', \'jobs.sample.read\', \'inventory.sample.read\'],\n  },\n  {\n    id: \'dev_vehicle_screen\',\n    name: \'Ajoneuvon\303\244ytt\303\266 (Transporter T6)\',\n    type: \'vehicle_display\',\n    platform: \'Android Automotive OS 14\',\n    authorized_at: \'2026-10-20T07:45:00Z\',\n    last_seen: \'23 min sitten\',\n    status: \'standby\',\n    is_current: false,\n    permitted_capabilities: [\'ai.chat\', \'route.sample.read\', \'telemetry.safe\'],\n  },\n  {\n    id: \'dev_macbook_workstation\',\n    name: \'MacBook Pro (P\303\244\303\244teasema)\',\n    type: \'workstation\',\n    platform: \'macOS Sonoma / Edge\',\n    authorized_at: \'2026-10-01T10:00:00Z\',\n    last_seen: \'3 tuntia sitten\',\n    status: \'standby\',\n    is_current: false,\n    permitted_capabilities: [\'ai.chat\', \'tasks.plan_only\', \'admin.experiences\', \'notes.readwrite\'],\n  },\n];\n\nexport interface FieldServiceJob {\n  id: string;\n  customer: string;\n  address: string;\n  time_window: string;\n  type: string;\n  description: string;\n  priority: \'Normaali\' | \'Kiireellinen\' | \'Kriittinen\';\n  status: \'Aikataulutettu\' | \'K\303\244ynniss\303\244\' | \'Valmis\';\n  required_parts: string[];\n}\n\nexport const INITIAL_FIELD_JOBS: FieldServiceJob[] = [\n  {\n    id: \'job-101\',\n    customer: \'As Oy Tapiolan Tammisto\',\n    address: \'Mets\303\244nneidonkuja 6, Espoo\',\n    time_window: \'08:30 \342\200\223 10:00\',\n    type: \'Lukituksen sarjoitus\',\n    description: \'B-rapun porrasoven Abloy Protec2 -pes\303\244n vaihto ja 12 avaimen luovutus is\303\244nn\303\266itsij\303\244lle.\',\n    priority: \'Normaali\',\n    status: \'Aikataulutettu\',\n    required_parts: [\'Abloy Protec2 CY062\', \'Avainaihio x12\', \'Turvaruuvit M5\'],\n  },\n  {\n    id: \'job-102\',\n    customer: \'Kiinteist\303\266 Oy It\303\244merentorni\',\n    address: \'It\303\244merenkatu 11, Helsinki\',\n    time_window: \'10:45 \342\200\223 12:30\',\n    type: \'\303\204lylukkoasennus\',\n    description: \'Neuvotteluhuoneen lasioven Yale Doorman L3S -asennus ja yhdist\303\244minen kulunvalvontaan.\',\n    priority: \'Kiireellinen\',\n    status: \'Aikataulutettu\',\n    required_parts: [\'Yale Doorman L3S Chrome\', \'Vastakappale 1487-1\', \'Akkusarja AA\'],\n  },\n  {\n    id: \'job-103\',\n    customer: \'Logistiikkahalli Keh\303\244 III\',\n    address: \'Tiilitie 4, Vantaa\',\n    time_window: \'13:30 \342\200\223 15:15\',\n    type: \'Ovensulkimen korjaus\',\n    description: \'Palo-oven Dormakaba TS 93 -hydrauliikan tarkastus, \303\266ljyvuodon korjaus ja s\303\244\303\244t\303\266.\',\n    priority: \'Normaali\',\n    status: \'Aikataulutettu\',\n    required_parts: [\'Dormakaba TS 93 Liukuvarsi\', \'Hydrauliikkatiivistesarja\'],\n  },\n];\n\nexport interface DriverStop {\n  id: string;\n  stop_number: number;\n  location_name: string;\n  address: string;\n  estimated_arrival: string;\n  stop_type: \'Toimitus\' | \'Nouto\' | \'Varikko / Huolto\';\n  instructions: string;\n  completed: boolean;\n}\n\nexport const INITIAL_DRIVER_STOPS: DriverStop[] = [\n  {\n    id: \'stop-01\',\n    stop_number: 1,\n    location_name: \'P\303\244\303\244varasto Lauttasaari\',\n    address: \'Vattuniemenkatu 18, Helsinki\',\n    estimated_arrival: \'08:00\',\n    stop_type: \'Nouto\',\n    instructions: \'Lastauslaituri 3. Ota keikkojen 101-103 varaosalaatikot.\',\n    completed: true,\n  },\n  {\n    id: \'stop-02\',\n    stop_number: 2,\n    location_name: \'As Oy Tapiolan Tammisto\',\n    address: \'Mets\303\244nneidonkuja 6, Espoo\',\n    estimated_arrival: \'08:25\',\n    stop_type: \'Toimitus\',\n    instructions: \'Soita huoltomiehelle p. 040 123 4567 portin avaamiseksi.\',\n    completed: false,\n  },\n  {\n    id: \'stop-03\',\n    stop_number: 3,\n    location_name: \'It\303\244merentorni\',\n    address: \'It\303\244merenkatu 11, Helsinki\',\n    estimated_arrival: \'10:40\',\n    stop_type: \'Toimitus\',\n    instructions: \'Pys\303\244k\303\266i huoltoruutuun C2 talon takana. Ilmoittaudu aulaan.\',\n    completed: false,\n  },\n  {\n    id: \'stop-04\',\n    stop_number: 4,\n    location_name: \'ABC Keimolanportti (Suositus)\',\n    address: \'Keimolantie 1, Vantaa\',\n    estimated_arrival: \'12:45\',\n    stop_type: \'Varikko / Huolto\',\n    instructions: \'AOS:n ehdottama 20 min lataus- ja lounastauko ennen iltap\303\244iv\303\244n huoltoa.\',\n    completed: false,\n  },\n];\n\nexport const INITIAL_NOTES = [\n  {\n    id: \'note-1\',\n    title: \'Keh\303\244 III huoltoreitin optimointi\',\n    content: \'Keh\303\244 I ruuhkautuu klo 15 j\303\244lkeen. Siirr\303\244 Tiilitien keikka alkamaan viimeist\303\244\303\244n klo 13:30.\',\n    category: \'Reitti & Logistiikka\',\n    date: \'T\303\244n\303\244\303\244n 07:45\',\n  },\n  {\n    id: \'note-2\',\n    title: \'Abloy Sento varaosatilaus\',\n    content: \'Tukusta tilattava 10 kpl CY062 -sylintereit\303\244 ensi viikon kiinteist\303\266sarjoituksiin.\',\n    category: \'Hankinnat\',\n    date: \'Eilen 16:20\',\n  },\n];\n\nexport const INITIAL_DMS_GOALS = [\n  {\n    id: \'goal-root-1\',\n    title: \'Lokakuun huoltotoiminnan luotettavuus (98 % SLA)\',\n    progress: 84,\n    status: \'active\',\n    provenance: \'DMS://goals/2026-q4/field-operations\',\n    children: [\n      { id: \'goal-sub-1\', title: \'Suorita t\303\244n\303\244\303\244n 3 kriittist\303\244 lukituskeikkaa\', progress: 33, status: \'in_progress\' },\n      { id: \'goal-sub-2\', title: \'Pid\303\244 huoltoauton osavaraston puutosaste alle 5 %\', progress: 95, status: \'on_track\' },\n      { id: \'goal-sub-3\', title: \'Minimoi ajonaikaiset tyhj\303\244k\303\244yntikilometrit\', progress: 78, status: \'on_track\' },\n    ],\n  },\n];\n\nexport const INITIAL_ACTIVITIES: ActivityEvent[] = [\n  {\n    id: \'act-1\',\n    timestamp: \'10 min sitten\',\n    device_id: \'dev_phone_9pro\',\n    device_name: \'Pixel 9 Pro\',\n    action_type: \'device_switched\',\n    summary: \'Laite valtuutettu ja synkronoitu AOS-tilille hannu@primus72.com\',\n    skin_id: \'everyday-assistant\',\n    canonical_status: \'completed\',\n    source: \'live\',\n  },\n  {\n    id: \'act-2\',\n    timestamp: \'25 min sitten\',\n    device_id: \'dev_tablet_air\',\n    device_name: \'iPad Air 11\"\',\n    action_type: \'proposal_approved\',\n    summary: \'Aamun huoltot\303\266iden varaosavarauksen plan_only hyv\303\244ksytty\',\n    skin_id: \'field-service-demo\',\n    canonical_status: \'completed\',\n    source: \'demo\',\n  },\n  {\n    id: \'act-3\',\n    timestamp: \'1 h sitten\',\n    device_id: \'dev_macbook_workstation\',\n    device_name: \'MacBook Pro\',\n    action_type: \'skin_customized\',\n    summary: \'Field Service -n\303\244kym\303\244n widget-j\303\244rjestys tallennettu palvelimelle\',\n    skin_id: \'field-service-demo\',\n    canonical_status: \'completed\',\n    source: \'live\',\n  },\n];\n"

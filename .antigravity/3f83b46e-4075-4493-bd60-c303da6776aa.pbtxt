      thinking_signature: "\022\274\t\n\271\t\001i\024}\023\305.F\337\241d\362\3510\352L\245\031g\266\262\265\276\312\255\275\a\302\005\273yc\207\201\352\341\323\371\t\205l\335_\037\201\334\210$\003\246\200W\037\235S\343\216\264\215\364Q\366L\220\353\233\277\311\323\037\362\231h\353\220\017\030u\a\275\016s\'06\004\202S\263\022C\000\266\235\f\314\200\365\345KL}\221\316\361\253C\202\222\343\020\017\021d\274\340\300\347E\"\244\177\0231\271?`\311\240\306X\373\r+\340\245\214\304j\236\331\020\331\372=\327\336\217\224\202\334%\351\223\317\212\262\202R\336\365\026\237\314\277\254`q\210w\366\313\376\373\333l\220\300G\324\265H\rT\267v\371\306\030\2130|6\032`\263\270l\3413W\255\a\242\374!\346\006\317\217\004T\304\334\237\225S\310\b\324/\222|\306\321g\"\254ED\300?%\273\367\332\364V\276\304]xk\201hL\363J\220\313\302\\\260\341;\260c\232\207\346U\300\255\2268\254\333\371\3519<\026\234\201\355\216\233\253\210`\f;v\205\213\202\025\354\350f~\250\352\207\n`\274\304\211\373\211&\025\332\243\256\202F\356o\311\265[\334\f\024M\274_&\257\265\210<\241\364\006D\n\354y!\v\353_\'\243w\307\032wj\341\v\274\t\311(\374#S\032\020\v\270\252w\031N\201e\226/w\335\360#\251\247\202\001\003?\a\203*g\030\261;F\005\242_\b\2321\375\a&\247\204\337\000\372\026|Q\242\223\237k\233H7\\\251[C\0222\365\255\207n\335\215p\261u\203N\204\323\322o\264\222\372\341\267\334\033\374\330\257P\0211K\355~\n\306\212\222\213\023\352\347W4k\340u\212\022y;\017|\257Tx\034\003\3647{\215#\350\036\363\v\2757\370\217\001\027G\320\335\341\342~\034\231\rF\346\270\001\225BV0|\337\217\322J\301\'Hr\370Sk\245\376\214\255\371+\242\n\310\362\210\370\241\031\261\230\005eE\373\312!>\"\317\224\017dG\002].\375\021\000\205\311]YH^\316W\341;\003FA{\023H\351q\322\233\207\3639\251$D[]L\000Q8\210p]~\312\312^\022\200\210\240%\263\222\005\211\312~\221\316\000\177^\202\225Q\207\261\252\n\362[\324\2665&)Y\261\201\030\377\036\\\r\3234\0201\202\b\346\210\356\\\f\375\340\035\241\250\325\001}\213C\225\372e\232c\315\351<w\235;\275>i<\214\035\224\267E\177\\C\250\021\206\203\210g\257\363{\330UQu\213\200\313\tE\215E\0040\303\a4\021\273o\022\006M\364\342\2747\001\277\021\253\351J\240\036\257\206J\210u\023\303\224\253\341\277\361\212\'g\332\002I\353\317r\017\025\313}\372\352\266\325\342\217\212\361\212j\035J\n\266w\272 \031\000\020\357\004\315b\334\314\001]\253N\bf\024\367\345\370\355WpH\243;TqU\230\205\346\367\320\031\226kg\236Bgj\257c\270\235$\372e\243\3026\004\217\203B\310\037\353\321\273\230s(boj\276Wh1s\022m\2164\312Wv\377\357`EpY\000\336Ob\365\004@\230\3035\262P\354 w\203,\225\364C\224;\aI\241\344h\366d\252\222\337\271\263[\re\rI\222I\rU\030 \234\035a\325[\237\227\306\272+D\377\321R\215,\342\250\233\216!J\204\335\305\227R9%\344\261C\322\241\177og\031\347\t\267\334G\303\211\333\367W>\243\271\241]x\202\335\372\034\311p\353\2621\207\234\r\036\320\206\210\025\"~*\001\320\371s\203\031>\rz\370\314\351\257Qsd\200\2205\332a\004\003\332)-\271\330|\277pcAF\365\240\301L\370\217\032M\257\006\034?\353\305\362\312.\3477$\v\231A\212\244scr\356\204^g\267\335C\325k\345L\025/\337g\303>\364\r\313\350\237\266\376;\371JCOw\317h;^\225\360*R\216\200\263\331\263\301\227x\204\277\027\002\02189Z\360\236QX\276%\224\236.\035!\235d\037A\304\376\203\tE\365\225\335\266]\031)\036\213K\204\000\330\"E\200\025\374\363\314\370\031\353\b<\241\f\033\324\216\304\r<\002G\037\213\275\343\226&\267\212\313\244\330\017E\035|\"X\257\232\201$/H .\017\271\335\004w\247\021\323G\226k\022\314\356pH=\204e\020qsz\264\204\374\322\266\n\r$7*(\226\232\2039/\373A\256\252\030\212\f\213^\260\323\325&\275K\222\326\2319\353"

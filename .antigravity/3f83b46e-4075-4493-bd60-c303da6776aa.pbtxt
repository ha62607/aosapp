      thinking_signature: "\022\205\017\n\202\017\001i\024}\023^^\274\216\3672\255\021Q\230U\203`\352T\241k\2327\337@\252\341R\032\364\202\244\230\006\275\356\256s\263jc\315\351u\016U\273\a\363C\211\372\304\256$\340\027\372\364\b\213\322\262E\316b\003p\213\203q\210\023\233\031\340\266\000O\377\345_tb\016\006\254H\323\313\300\367\317t\266\332\277\212\225b\324\276\327\200\353\375/\3467q\230\360 \"?d\324cP\025:\2707\b\345\201@\330\243\215lZ\032\231a\216z\374\203Dz\356T\333\034i\023\006\337\364\317\244\236]*0\r]\005\034\325N\215\370\037\243)\005\214\027\316\362!\037\\\201&\364\205\327\232q>\270\314\247\314r\327\n(KS\220s1\302l\322\302\220\352u\316\262~\246\230\242\364@\0048d-\240\371#GF\216\b\307\212\232=\260t\002\330&\317\317\227\226\016\034\224\017[:\305\204\240\324\357\213is\343\323\373g\034\206\ri\233\275\205`\256\207K\326\300\020f\a0\221\233\031\323<\312L\210h\n\316\227I\252t\214\336\243\240\v\006\'f\2001\222\202\376\332\224\032\244\031x^\266F\226;\'\234\035\271u\367\377,\271\t\354\020b\222 \311b\303\017V\205O\300Q\210\361\272\361+\000\342a2\252\305\365HW*\251\222\315n\206\212\242\237\250\201\3724h\366\321\2606\253\"\322\324\310\'\266?y\215\276W\0353\301\255\307\2750h]\356\361\034k\215\225\217\031\245\r\252\315\302V_4\212\2637\205\253\315}>\333\000\344\\\300{\266\373:\005\"\301\203\263\353N\240\230\336\001\0062\303wK\234e\265\240q\177\327\330\033\212\331\362\355I\275\214vQBf\021\213\002R\240\203\314\261\205b\221{0\307w(\367f\231b\023\336.\005\004\3427\223\361\204\324O\"\312\"\027\245\036\r\304\316\310\237\017*H\306m\232\201\v+\241\327\371\201\030\b\321\363\025:\263\352c\r\017\354\353yR\320\222P\206\204\301\033\262\bibZ/\234\315\031\333\266\307\207`\037\265\r2yG\2126C\035e\200\330Fl1\214\354FQxTm\374\234\273\373\216\330.\340\216\221\350\320h \"\254\021\227\367\243\361\2163\025_\301;\372\212\r7du\027Z\025\335A\313\263\005K2J\277\t\027\341\310\t1P\b16\\\261\r\263\241\021m\207\230Y<\265B9\210\203:`\017\026\357\247\345\207*\360O\210\260\027\303H\314ozv\264R\257\335\232\355*\263\260\370c\232\023\f\327\2053\265ZQ\2178$c\345]~\207\003:\020\a\"m$*\335=\025\215\205\355\320\2617\352\3750\342\322\237\331\362\3112\272UC\231\206\362;Q\275e\255\200\026\324F\r\031\216\230\\cj\n\321\243\363\027\267e\a\256\206\322/\340\353\t\271\343\241\250\270\225\026\232PI\027r\352\313?[D\262\337\204,\356\217SP\301\277K4\023C\034]\354\265cP\002\222{e\342\354\236\355\255\205\247\243x\374\370C\213\001\2031\032p\n\336V\334\210#j\361\333\371\372\023Lh\207\250n\253\253Z\027m\311\341\260\224\247\215P\343\aa\233{\342\002\256\251P\'\230\017\250\202\253v\352^\224\333\fpE\370S\211!o!l\345\000\267\311\244\213\253s\260_\261j^\314\356I;\216H\347\032l\327\004\223\v\t\250_p\250\005\253\201E\317~\250Y\016\372\315\353p p\034(\331B\371\355\3035\0170\245JG\307\211=x\342\2717\355\353\030K\347!F\230)M0\337d\225\"o\315\200\366\205 \3201)I\243\262-\240t\006\220\242/\302 \271\303\217\221\220\344\316p@&>\322k\220\363\203\202\305\034q\345\362\332Fs\227\364\304\021\306\227\342Y;\356\354\371\352\344}\0362aW0%\363\3119\222\256\331S\220\035R.8\305)\236\3066\237xD\316ca,\344\226\3360%K\2722\223\v\245\301g\276C\367\021\220J\3001\372\336\336\352\234O\333\236\002\372\251\327\016\024I\"K\003\312\273\017\363\03113\210\276\205\aSy\270\fDA@\032\306\020\341`\233+`\360\354\332\317H\351\32451hB\001\215\254\224bd\240\"\363w\342Y\2041\235\350\227\275z\032c\226\343VYw?\365\370\324\003\217\277\031v\200\354[\202]\031#\310\177\311\265\v\266\235\032\267\310Y\376\301K\301l:J\344\271\307\222\321\003\242,b\250\027Z\213\027\375@My3v\351\271\324H\237\a8\316\005\332d\376YA\343P?\265\213\335\337\256~\236Rg~[\210\352p\375\307ji\245m\254@I\211i\363\206\345\323\372&P\032\225=Ay\025wO\262\223P\027C\3434%pJ\331Fs\367\215-\340^)\257l\324W(&\264\006\024\205\372a~S4x=4\373\331r\3319\275\304\344\363hm;l\026\3548\242\326\373\366\2557F-\261`\333\0017\004\345\254\217\244\211>s\212\266\303\254\343\344\336i\244\250\310u\365\\\274\365o\263\217\003x\344].\032\334\033\240\243o|z\213\257\237x^S\257\n@\241\365^\304\325\340$\262\365\364O\231\177\214i\265\207\000\360&\236\302\346*)(P\214\261\217r\271J\376\020;\252\307\200!v,\324;\366\005\341\370\r\260\256\3111*(a\024s\020\364/\331\227gN\241\330q\002<,(\273\023X\240@\326LNi[\021\327\233\202+\265\373u\372\277\265E\n\037\352\262\267eK\037z83\263C\333\244u\033\254E\2357\v\022\275\360~\b\a\311\343\316!8\300(\366\377\323\303\235{\341\343}\222\341\206\344KGG{96\f\326\2602\177\327\245Jd\n\326g\215\362w\301v\343\364\213\217J\227\t\337a\2218QT\')\325\256\266\272\254\257\r;\316\301\2730\251a(IB\261LW\310\333\017\215cb9\336\327\003\307P\335\321\324(a\361\266(\306\203\370r\317\0168\313yvX\276\213\242c$\002\201\364\030\374c\361\352$\n\310\020n\264\265\272dC\353\016LjU\"\257\224\341\362`\324<r\342\203\324\020\227\337\202g\224N\341\372v`\023|\030\244:3\225\321\205\233^\ab\341\326\021\230\003\212\300\273\021\277x+\222\206\205X`dm\323\341\262\206\004\344\t\235\337\250\f(\354\241\230\303\201d\200ikX\344D\342\300\006\246_\b\221n\334\323H\276@\372M\206|c\252\267\005\032\335$\276\v0\215}!o\006\211V\374\215\255G^\3500\240\272\2423\362\340\"\016\216H\211\270D\217\233\334\215O\270\352\334\226\313J\241\336c\324}nO\265[\030#\212\201\332\f\267\331\276\370)A\177\247\251\334\271\230j\273\333^BI\370\264\370A\031G\343a\027H\373\320\312u\346,\201#9\024\344\226\2601\177D\204\3214\245D\332P31\3249\236\331\3555U(\274\344U,\311GII6vw\245\350|\026\262\242\376?\326\204\357\267\366\224\343\203\325\214\350\367o#\3256\310\355\n\336y\375\023w\3330\267\335\016j\354\317i\217R\347A\300ySw\270dkrSB\243\232\326\f"

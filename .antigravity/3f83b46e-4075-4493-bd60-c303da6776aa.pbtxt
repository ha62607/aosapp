        replacement_chunks {
          target_content: "export async function resetExperienceConfig(skinId: string): Promise<ExperienceLayoutConfig> {\n  const skin = store.skins.find((s) => s.skin_id === skinId);\n  const order: Record<string, string[]> = {};\n  skin?.views.forEach((v) => {\n    order[v.id] = [...v.widget_ids];\n  });\n  const reset: ExperienceLayoutConfig = {\n    skin_id: skinId,\n    display_name: skin?.display_name || skinId,\n    view_widget_order: order,\n    accent_color: skin?.accent_color || \'#4f46e5\',\n    updated_at: new Date().toISOString(),\n    version: 1,\n  };\n  store.layouts.set(skinId, reset);\n  return reset;\n}"
          replacement_content: "export async function resetExperienceConfig(skinId: string): Promise<ExperienceLayoutConfig> {\n  const skin = store.skins.find((s) => s.skin_id === skinId);\n  const order: Record<string, string[]> = {};\n  skin?.views.forEach((v) => {\n    order[v.id] = [...v.widget_ids];\n  });\n  const reset: ExperienceLayoutConfig = {\n    skin_id: skinId,\n    display_name: skin?.display_name || skinId,\n    view_widget_order: order,\n    accent_color: skin?.accent_color || \'#4f46e5\',\n    updated_at: new Date().toISOString(),\n    version: 1,\n  };\n  store.layouts.set(skinId, reset);\n  return reset;\n}\n\n/**\n * Skin Studio \342\200\224 Dynamic Custom Skin Creation & AI Generation\n */\nexport async function createCustomSkin(manifest: SkinManifest): Promise<SkinManifest> {\n  // Validate manifest\n  if (manifest.schema_version !== \'aos.skin.v0.1\') {\n    throw new Error(\'Virheellinen skeemaversio. Vaaditaan aos.skin.v0.1\');\n  }\n\n  const existingIndex = store.skins.findIndex((s) => s.skin_id === manifest.skin_id);\n  if (existingIndex >= 0) {\n    store.skins[existingIndex] = { ...manifest, installed: true };\n  } else {\n    store.skins.push({ ...manifest, installed: true });\n  }\n\n  // Initialize layout config\n  const order: Record<string, string[]> = {};\n  manifest.views.forEach((v) => {\n    order[v.id] = [...v.widget_ids];\n  });\n\n  store.layouts.set(manifest.skin_id, {\n    skin_id: manifest.skin_id,\n    display_name: manifest.display_name,\n    view_widget_order: order,\n    accent_color: manifest.accent_color,\n    updated_at: new Date().toISOString(),\n    version: 1,\n  });\n\n  const currentDevice = store.devices.find((d) => d.is_current) || store.devices[0];\n  recordActivity({\n    device_id: currentDevice.id,\n    device_name: currentDevice.name,\n    action_type: \'skin_customized\',\n    summary: `Uusi kokemus luotu ja asennettu Skin Studiolla: ${manifest.display_name}`,\n    skin_id: manifest.skin_id,\n    canonical_status: \'completed\',\n    source: manifest.kind === \'demo\' ? \'demo\' : \'live\',\n  });\n\n  return manifest;\n}\n\nexport async function generateSkinWithAI(promptText: string): Promise<SkinManifest> {\n  const lower = promptText.toLowerCase();\n  const skinId = `skin_custom_${Date.now()}`;\n\n  // Smart domain template detection\n  if (lower.includes(\'lvi\') || lower.includes(\'putki\') || lower.includes(\'l\303\244mp\303\266\') || lower.includes(\'ilmastointi\') || lower.includes(\'hvac\')) {\n    return {\n      schema_version: \'aos.skin.v0.1\',\n      skin_id: skinId,\n      display_name: \'LVI- ja Kylm\303\244laitehuolto\',\n      version: \'0.1.0\',\n      kind: \'production\',\n      description: \'L\303\244mp\303\266-, vesi- ja ilmastointiasentajien operatiivinen ty\303\266p\303\266yt\303\244: mittausp\303\266yt\303\244kirjat, vikakeikat, painetestit ja osavarasto.\',\n      tagline: \'LVI-teknikon kentt\303\244ty\303\266nohjaus\',\n      icon: \'Wrench\',\n      primary_color: \'#0284c7\', // sky\n      accent_color: \'#38bdf8\',\n      required_capabilities: [\'ai.chat\', \'tasks.plan_only\', \'measurements.read\'],\n      requested_permissions: [\'jobs.sample.read\', \'hvac.telemetry\'],\n      installed: true,\n      is_active: false,\n      views: [\n        {\n          id: \'hvac-overview\',\n          title: \'Huoltoty\303\266t & Painearvot\',\n          icon: \'Wrench\',\n          widget_ids: [\'hvac-metrics\', \'hvac-jobs\'],\n        },\n        {\n          id: \'hvac-request\',\n          title: \'Uusi LVI-suunnitelma\',\n          icon: \'FilePlus\',\n          widget_ids: [\'hvac-composer\'],\n        },\n        {\n          id: \'hvac-parts\',\n          title: \'Putkiosat & Venttiilit\',\n          icon: \'Package\',\n          widget_ids: [\'hvac-inventory\'],\n        },\n      ],\n      widgets: [\n        {\n          id: \'hvac-metrics\',\n          component_type: \'metric-group\',\n          title: \'LVI-j\303\244rjestelmien tilanne\',\n          data_source: \'demo:hvac\',\n        },\n        {\n          id: \'hvac-jobs\',\n          component_type: \'record-list\',\n          title: \'P\303\244iv\303\244n LVI-huoltopyynn\303\266t\',\n          data_source: \'demo:field-service\',\n        },\n        {\n          id: \'hvac-composer\',\n          component_type: \'intent-composer\',\n          title: \'Laadi painetestaus- tai huoltosuunnitelma\',\n          data_source: \'aos:proposals\',\n        },\n        {\n          id: \'hvac-inventory\',\n          component_type: \'record-list\',\n          title: \'Huoltoauton LVI-varaosat\',\n          data_source: \'demo:inventory\',\n        },\n      ],\n    };\n  }\n\n  if (lower.includes(\'is\303\244nn\303\266i\') || lower.includes(\'kiinteist\303\266\') || lower.includes(\'taloyhti\303\266\')) {\n    return {\n      schema_version: \'aos.skin.v0.1\',\n      skin_id: skinId,\n      display_name: \'Kiinteist\303\266 & Is\303\244nn\303\266inti\',\n      version: \'0.1.0\',\n      kind: \'production\',\n      description: \'Taloyhti\303\266iden ja kiinteist\303\266managerin hallintaty\303\266kalu: asukasilmoitukset, PTS-kunnossapitotarpeet ja urakoitsijatarkastukset.\',\n      tagline: \'Is\303\244nn\303\266itsij\303\244n ja kiinteist\303\266managerin ty\303\266tila\',\n      icon: \'Building\',\n      primary_color: \'#16a34a\', // green\n      accent_color: \'#22c55e\',\n      required_capabilities: [\'ai.chat\', \'tasks.plan_only\', \'dms.goals\'],\n      requested_permissions: [\'properties.read\', \'tickets.manage\'],\n      installed: true,\n      is_active: false,\n      views: [\n        {\n          id: \'property-overview\',\n          title: \'Taloyhti\303\266iden katselmus\',\n          icon: \'Building\',\n          widget_ids: [\'prop-metrics\', \'prop-goals\'],\n        },\n        {\n          id: \'property-notes\',\n          title: \'Kunnossapitomerkinn\303\244t\',\n          icon: \'FileText\',\n          widget_ids: [\'prop-notes\', \'prop-composer\'],\n        },\n      ],\n      widgets: [\n        {\n          id: \'prop-metrics\',\n          component_type: \'metric-group\',\n          title: \'Kiinteist\303\266jen huoltovaste & SLA\',\n          data_source: \'demo:general\',\n        },\n        {\n          id: \'prop-goals\',\n          component_type: \'record-list\',\n          title: \'PTS 5-vuotiskorjaussuunnitelma\',\n          data_source: \'dms:goals\',\n        },\n        {\n          id: \'prop-composer\',\n          component_type: \'intent-composer\',\n          title: \'Valmistele hallituksen katselmusp\303\266yt\303\244kirja\',\n          data_source: \'aos:proposals\',\n        },\n        {\n          id: \'prop-notes\',\n          component_type: \'notes-board\',\n          title: \'Is\303\244nn\303\266itsij\303\244n huomiot & urakoitsijamuistiot\',\n          data_source: \'demo:general\',\n        },\n      ],\n    };\n  }\n\n  // Default custom generated skin\n  const name = promptText.length > 3 ? promptText.slice(0, 30) : \'R\303\244\303\244t\303\244l\303\266ity Toimialakokemus\';\n  return {\n    schema_version: \'aos.skin.v0.1\',\n    skin_id: skinId,\n    display_name: name.charAt(0).toUpperCase() + name.slice(1),\n    version: \'0.1.0\',\n    kind: \'production\',\n    description: `AOS Skin Studion luoma kokemus toiveesta: \"${promptText}\"`,\n    tagline: \'R\303\244\303\244t\303\244l\303\266ity ammattilaiskokemus\',\n    icon: \'Sparkles\',\n    primary_color: \'#6366f1\',\n    accent_color: \'#818cf8\',\n    required_capabilities: [\'ai.chat\', \'tasks.plan_only\'],\n    requested_permissions: [\'profile.read\', \'notes.readwrite\'],\n    installed: true,\n    is_active: false,\n    views: [\n      {\n        id: \'view-main\',\n        title: \'Yleisn\303\244kym\303\244\',\n        icon: \'LayoutDashboard\',\n        widget_ids: [\'custom-composer\', \'custom-metrics\'],\n      },\n      {\n        id: \'view-tasks\',\n        title: \'Teht\303\244v\303\244t & Tavoitteet\',\n        icon: \'Target\',\n        widget_ids: [\'custom-goals\', \'custom-notes\'],\n      },\n    ],\n    widgets: [\n      {\n        id: \'custom-composer\',\n        component_type: \'intent-composer\',\n        title: `AOS AI -s\303\244velt\303\244j\303\244: ${name}`,\n        data_source: \'aos:proposals\',\n      },\n      {\n        id: \'custom-metrics\',\n        component_type: \'metric-group\',\n        title: \'P\303\244iv\303\244n tila & mittarit\',\n        data_source: \'demo:general\',\n      },\n      {\n        id: \'custom-goals\',\n        component_type: \'record-list\',\n        title: \'DMS Tavoitteet\',\n        data_source: \'dms:goals\',\n      },\n      {\n        id: \'custom-notes\',\n        component_type: \'notes-board\',\n        title: \'Muistiinpanot & havainnot\',\n        data_source: \'demo:general\',\n      },\n    ],\n  };\n}"

            lines {
              text: "### Mit\303\244 sovellus tekee"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "AOS (Agent Operating System) on ihmisohjattu, teko\303\244lynatiivi henkil\303\266kohtainen ja liiketoiminnallinen operatiivinen kerros. K\303\244ytt\303\244j\303\244 ei keskustele geneerisen chatbotin kanssa, vaan antaa intentioita luonnollisella kielell\303\244. AOS tulkitsee pyynn\303\266n rakenteelliseksi **ehdotukseksi (Proposal)**, joka sis\303\244lt\303\244\303\244 tavoitteen, suoritusvaiheet, tarvittavat luvat ja riskitasot. Toimenpiteit\303\244 ei koskaan suoriteta automaattisesti ilman ihmisen nimenomaista hyv\303\244ksynt\303\244\303\244 (**Human Approval**)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Kohderyhm\303\244 ja arvo"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Pienyritykset ja kentt\303\244ty\303\266 (Field Service / Lukkosepp\303\244 / LVI)**: Ty\303\266tilausten hallinta, reittisuunnittelu, asiakaskonteksti ja huoltok\303\244yntien valmistelu ilman monimutkaisia ERP-h\303\244rveleit\303\244."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Mobiilit kuljettajat ja toimitus (Driver)**: Kontekstitietoinen, turvallinen ja selke\303\244 n\303\244kym\303\244 pys\303\244hdyksiin, kiinnostuksen kohteisiin ja ehdotuksiin."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT

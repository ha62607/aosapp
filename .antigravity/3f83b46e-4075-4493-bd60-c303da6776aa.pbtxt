            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### A. Mik\303\244 se on?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Visuaalinen ja teko\303\244lyavusteinen kehitysn\303\244kym\303\244, jolla voit:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Luoda uuden toimialaskinin promptilla** (esim. *\"Luo skin LVI- ja kylm\303\244laiteasentajalle\"* tai *\"Suunnittele is\303\244nn\303\266itsij\303\244n kiinteist\303\266katselmusty\303\266kalu\"*)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Generoida deklaratiivinen `aos.skin.v0.1` -manifesti**: AOS AI -tulkitsija generoi tarvittavat n\303\244kym\303\244t, widgetit, v\303\244riteemat ja lupavaatimukset."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Reaaliaikainen Sandbox-esikatselu**: N\303\244et heti puhelimen ja tabletin kokoisessa esikatseluikkunassa, milt\303\244 uusi skin n\303\244ytt\303\244\303\244 ja miten sen widgetit asettuvat."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Yhden klikkauksen asennus**: Voit tallentaa ja ottaa uuden suunnittelemasi skinin heti k\303\244ytt\303\266\303\266n omalla tilill\303\244si ja kaikilla N valtuutetulla laitteellasi."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### B. K\303\244ytt\303\266liittym\303\244 ja komponenttirakenne"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Studio-n\303\244kym\303\244 (`SkinStudioView.tsx`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Prompt-s\303\244velt\303\244j\303\244*: Sy\303\266t\303\244 uuden kokemuksen toimiala ja k\303\244ytt\303\244j\303\244tarina."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Visuaaliset s\303\244\303\244timet*: P\303\244\303\244v\303\244ri (Primary color), korostusv\303\244ri (Accent), kuvake ja teema."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *N\303\244kym\303\244- ja widget-rakentaja*: Lis\303\244\303\244 ja j\303\244rjestele mittariryhmi\303\244, listoja, reittin\303\244kymi\303\244 ja AI-s\303\244velt\303\244ji\303\244."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *JSON-manifestieditori*: Ammattilaisn\303\244kym\303\244, joka validoi skeeman reaaliaikaisesti ennen tallennusta."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - *Live Preview*: Interaktiivinen esikatselu, jossa toimivat klikkaukset ja tilasiirtym\303\244t."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Toteutusvaiheet koodissa"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Palvelin- ja API-laajennus (`src/services/aosApi.ts`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Lis\303\244t\303\244\303\244n `createCustomSkin(manifest: SkinManifest)` ja `generateSkinWithAI(prompt: string)`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Varmistetaan manifestin turvallisuusvalidointi (ei suoritettavaa koodia, sallitut widget-tyypit)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Skin Studio -komponentti (`src/components/SkinStudioView.tsx`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Luo uusi visuaalinen suunnitteluty\303\266kalu."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Sis\303\244lt\303\244\303\244 esiasetetut mallipohjat (esim. *LVI-huolto*, *Kiinteist\303\266nhoito*, *Myyntiedustaja*)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **P\303\244\303\244n\303\244kym\303\244n ja navigaation p\303\244ivitys (`src/App.tsx`, `src/components/BottomNav.tsx`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {

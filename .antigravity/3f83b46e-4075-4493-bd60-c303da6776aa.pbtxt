            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Demo 1 \342\200\224 Field Service (Lukkosepp\303\244/Huolto - ROI-tarina)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - K\303\244ytt\303\244j\303\244 avaa Field Service -skinin ja n\303\244kee t\303\244m\303\244n p\303\244iv\303\244n 3 ty\303\266tilausta."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Sy\303\266tt\303\244\303\244 intentin: *\"Valmistele huomisen kolmen lukkoasennusk\303\244ynnin aikataulu ja tarvittavat varaosat\"*."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - AOS luo strukturoidun ehdotuksen: analysoi varaosatarpeen, arvioi matka-ajan ja laatii `plan_only`-suunnitelman."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - K\303\244ytt\303\244j\303\244 tarkastaa, muokkaa yht\303\244 vaihetta ja klikkaa **Hyv\303\244ksy (Approve)**. Tila siirtyy kanoniseen tilaan `completed` selkein evidenssikirjauksin ilman luvattomia ulkoisia mutaatioita."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Demo 2 \342\200\224 Mobile Driver (Konteksti & Laitevaltuutus)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - K\303\244ytt\303\244j\303\244 vaihtaa Driver-skiniin samalla tilill\303\244."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - P\303\244\303\244n\303\244kym\303\244ss\303\244 on reitti, pys\303\244hdysluettelo ja ehdotettu varikkopys\303\244hdys."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Vaihdetaan laitesimulaattorissa laitetta (esim. *Ajoneuvon\303\244ytt\303\266*): n\303\244hd\303\244\303\244n suurennettu, ajon aikana turvallinen minimin\303\244kym\303\244 ja todetaan, ett\303\244 sama tili ja tavoitetila synkronoituu reaaliajassa."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Demo 3 \342\200\224 Customization & Skin Library**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Avataan Skin Library, tutkitaan lupia ja asennetaan lis\303\244skini."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Avataan *Mukauta kokemusta* -editori, j\303\244rjestet\303\244\303\244n widgetit uudelleen, tallennetaan palvelimelle (`Save`), ja varmistetaan pysyvyys selaimen p\303\244ivityksen j\303\244lkeen (mukana aito `Cancel`/palautus oletuksiin)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 6. Toteutettavat tiedostot ja ty\303\266vaiheet"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Pakettien tarkistus ja PWA-tuki**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `vite-plugin-pwa` asennus ja konfigurointi `vite.config.ts`-tiedostoon."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - PWA-manifesti (`manifest.webmanifest`), ikonit (`/icon.svg`, `/pwa-192x192.png`, `/pwa-512x512.png`) ja asennuskehote (`PWAInstallButton`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Ydinarkkitehtuuri ja Tyypit (`src/types/aos.ts`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - SkinManifest, Widget, Proposal, Device, Account, ActivityEvent."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **BFF & Adapter -kerros (`src/services/aosApi.ts` & Express-rajapinta)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Mock/Live REST -p\303\244\303\244tepisteet: `/api/v1/me`, `/api/v1/skins`, `/api/v1/experiences`, `/api/v1/intent/interpret`, `/api/v1/proposals/:id/approve`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Gemini AI -integraatio valinnaisella API-avaimella ja deterministisell\303\244 varmennusk\303\244sittelij\303\244ll\303\244."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Valmiit Skin-m\303\244\303\244rittelyt (`src/data/defaultSkins.ts`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - `everyday-assistant`, `field-service-demo`, `driver-demo`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Widget Registry & Renderer (`src/components/widgets/`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Deklaratiivinen komponenttien render\303\266inti (MetricGroup, RecordList, RouteDisplay, IntentComposer, NotesBoard)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **K\303\244ytt\303\266liittym\303\244komponentit (`src/components/`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - TopHeader, BottomNav, DeviceSimulatorBar, IntentProposalModal, SkinCustomizerModal, SkinLibraryView."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. **P\303\244\303\244sovellus (`src/App.tsx`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Responsiivinen pohja, laitetilan vaihto, tab-navigaatio ja ilmoitukset."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "8. **Testaus ja varmennus**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Lint, TypeScript-tyyppitarkastus (`compile_applet`), laitteistoresoluutioiden tarkastus (390px, 820px, 1440px)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 7. v0.2 Jatkosuunnitelma ja rajaukset (Gap List)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **v0.1:ss\303\244 toteutettu**: T\303\244ysi toiminnallinen pystysiivu, PWA, 3 skini\303\244, widget-renderer, intent->proposal-ty\303\266nkulku, laitesimulaattori, deklaratiivinen editori."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **v0.2 Priorisoidut jatkokehitykset**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. *Aito DMS/DOMstory Goal Tree -liit\303\244nt\303\244*: Tuotantotasoinen gRPC/REST-integraatio olemassa olevaan kanoniseen tavoitekantaan."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. *Reaalikentt\303\244liittimet (Field Service)*: OAuth-suojattu kaksisuuntainen synkronointi (Jobber/ServiceTitan)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. *Turvallinen \303\244\303\244nikanava (VoiceOS)*: \303\204\303\244nipohjainen handsfree-ohjaus ajoneuvo- ja kentt\303\244skiniin WebRTC/Live API -protokollalla."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. *Google-managed Agent Execution*: Cloud Run & Gemini Enterprise Agent Platform -pilotointi pitk\303\244kestoisiin ty\303\266nkulkuihin."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }

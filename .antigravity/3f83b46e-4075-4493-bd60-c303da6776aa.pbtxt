      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n * AOS Product v0.1 \342\200\224 Authoritative DTO & Contract Definitions\n */\n\nexport interface AOSAccount {\n  id: string;\n  name: string;\n  email: string;\n  tenant_id: string;\n  plan: \'Starter\' | \'Professional\' | \'Fleet Enterprise\';\n  status: \'active\' | \'suspended\';\n  created_at: string;\n  monthly_token_usage: number;\n  monthly_token_limit: number;\n}\n\nexport type DeviceType = \'mobile_phone\' | \'tablet\' | \'vehicle_display\' | \'workstation\';\n\nexport interface AOSDevice {\n  id: string;\n  name: string;\n  type: DeviceType;\n  platform: string;\n  authorized_at: string;\n  last_seen: string;\n  status: \'active\' | \'standby\' | \'revoked\';\n  is_current: boolean;\n  permitted_capabilities: string[];\n}\n\nexport interface WidgetDefinition {\n  id: string;\n  component_type:\n    | \'metric-group\'\n    | \'record-list\'\n    | \'intent-composer\'\n    | \'activity-list\'\n    | \'route-display\'\n    | \'notes-board\';\n  title: string;\n  data_source: string;\n  config?: Record<string, unknown>;\n}\n\nexport interface SkinViewDefinition {\n  id: string;\n  title: string;\n  icon?: string;\n  widget_ids: string[];\n}\n\nexport interface SkinManifest {\n  schema_version: \'aos.skin.v0.1\';\n  skin_id: string;\n  display_name: string;\n  version: string;\n  kind: \'demo\' | \'production\';\n  description: string;\n  tagline: string;\n  icon: string;\n  primary_color: string;\n  accent_color: string;\n  required_capabilities: string[];\n  requested_permissions: string[];\n  views: SkinViewDefinition[];\n  widgets: WidgetDefinition[];\n  installed: boolean;\n  is_active: boolean;\n}\n\nexport interface ProposedStep {\n  step_number: number;\n  title: string;\n  description: string;\n  permission_required: string;\n  risk_level: \'low\' | \'medium\' | \'high\';\n  duration_est?: string;\n}\n\nexport interface IntentProposal {\n  id: string;\n  tenant_id: string;\n  source: \'gemini\' | \'demo-mock\';\n  raw_intent: string;\n  interpreted_goal: string;\n  skin_id: string;\n  proposed_steps: ProposedStep[];\n  estimated_compute_tokens: number;\n  requires_human_approval: boolean;\n  status: \'draft\' | \'approved\' | \'rejected\' | \'executed\';\n  created_at: string;\n  evidence?: string;\n}\n\n// Canonical mcp-connector task states\nexport type CanonicalTaskState =\n  | \'queued\'\n  | \'running\'\n  | \'completed\'\n  | \'failed\'\n  | \'cancelled\'\n  | \'timed_out\';\n\nexport interface ActivityEvent {\n  id: string;\n  timestamp: string;\n  device_id: string;\n  device_name: string;\n  action_type:\n    | \'intent_submitted\'\n    | \'proposal_generated\'\n    | \'proposal_approved\'\n    | \'proposal_rejected\'\n    | \'task_completed\'\n    | \'skin_customized\'\n    | \'device_switched\';\n  summary: string;\n  skin_id: string;\n  canonical_status: CanonicalTaskState;\n  source: \'live\' | \'demo\';\n  metadata?: Record<string, unknown>;\n}\n\nexport interface ExperienceLayoutConfig {\n  skin_id: string;\n  display_name: string;\n  view_widget_order: Record<string, string[]>; // viewId -> widgetIds\n  accent_color: string;\n  updated_at: string;\n  version: number;\n}\n"
        path {
          absolute_uri: "file:///src/types/aos.ts"
        }
        overwrite: true
      }
    }

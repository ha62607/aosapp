            }
            lines {
              text: "## 1. Yleiskatsaus ja ydinajatus"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### Mit\303\244 sovellus tekee"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "AOS (Agent Operating System) on ihmisohjattu, teko\303\244lynatiivi henkil\303\266kohtainen ja liiketoiminnallinen operatiivinen kerros. K\303\244ytt\303\244j\303\244 ei keskustele geneerisen chatbotin kanssa, vaan antaa intentioita luonnollisella kielell\303\244. AOS tulkitsee pyynn\303\266n rakenteelliseksi **ehdotukseksi (Proposal)**, joka sis\303\244lt\303\244\303\244 tavoitteen, suoritusvaiheet, tarvittavat luvat ja riskitasot. Toimenpiteit\303\244 ei koskaan suoriteta automaattisesti ilman ihmisen nimenomaista hyv\303\244ksynt\303\244\303\244 (**Human Approval**)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### Kohderyhm\303\244 ja arvo"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Pienyritykset ja kentt\303\244ty\303\266 (Field Service / Lukkosepp\303\244 / LVI)**: Ty\303\266tilausten hallinta, reittisuunnittelu, asiakaskonteksti ja huoltok\303\244yntien valmistelu ilman monimutkaisia ERP-h\303\244rveleit\303\244."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Mobiilit kuljettajat ja toimitus (Driver)**: Kontekstitietoinen, turvallinen ja selke\303\244 n\303\244kym\303\244 pys\303\244hdyksiin, kiinnostuksen kohteisiin ja ehdotuksiin."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Yleisavustaja (Everyday Assistant)**: Henkil\303\266kohtainen ty\303\266tila muistiinpanoille, tavoitteille ja widget-koosteille."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "## 2. Todettu vs. Oletettu -matriisi (Verified vs. Assumed)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| Komponentti / Alue | Todettu tila (Verified) | Oletus / v0.1 Simulointi (Mocked) | Rajaus v0.1:ss\303\244 |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| :--- | :--- | :--- | :--- |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| **AOS Engine & BFF** | Briefin mukainen roolijako: Interpreter, Policy, Approval, Durable Workflow | Yhdistetty paikallinen Product BFF -adapteri Express/Client-tasolla | Reaalimaailman tuotantopalvelimia ei mutoida; tila on tenant- ja device-eristetty |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| **DMS / DOMstory** | Tavoitehierarkia (Goal Tree) ja konteksti kuuluvat DMS:lle | Paikallinen Goal Tree -projektiomalli | Ei itsen\303\244ist\303\244 kanonista tavoites\303\244il\303\266\303\244 skineiss\303\244 |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| **mcp-connector** | Kanoniset tilat: `queued`, `running`, `completed`, `failed`, `cancelled`, `timed_out` | Teht\303\244vien tilat noudattavat tarkalleen t\303\244t\303\244 kanonista sanastoa | `needs_approval` johdetaan UI-tasolla |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| **Multi-Device Sync** | Yksi tili, N laitetta palvelintasolla | BFF:n keskitetty in-memory/server-state tallentaa tilitilan ja synkronoi laitteet | Ei pelkk\303\244\303\244 localStoragea \342\200\224 laitesimulaattori todentaa jaetun tilan |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| **Kentt\303\244ty\303\266 & Keikat** | Selke\303\244sti merkitty `demo:field-service` -fikstuuri | Ei aitoja laskutus- tai asiakasviestint\303\244kutsuja | Kaikki toimenpiteet ovat `plan_only` |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "| **Sijainti & Reititys** | Kuljettajan reitit ja pys\303\244hdykset ovat deterministisi\303\244 mock-tietoja | Ei suoraa GPS-seurantaa ilman nimenomaista lupaa | Selke\303\244 mock-indikaattori jokaisessa n\303\244kym\303\244ss\303\244 |"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "## 3. K\303\244ytt\303\244j\303\244kokemus & Visuaalinen design (Mobile-First)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### A. N\303\244kym\303\244rakenne ja peukaloergonomia"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Top Bar Contract**: Yhden rivin otsikkopalkki: `[AOS Wordmark + Tilitunnus]` \342\200\224 `[Aktiivinen laite / Simulaattorikytkin]` \342\200\224 `[Skin Switcher & PWA Install]`."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Bottom Navigation Bar (Mobiili < 768px)**: 4 p\303\244\303\244kohteelle:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  1. **Home / Intent**: Keskusteleva s\303\244velt\303\244j\303\244, aktiiviset ty\303\266kalut ja jatka-kortit."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  2. **Experience (Aktiivinen Skin)**: Kentt\303\244ty\303\266, Kuljettaja tai Yleisn\303\244kym\303\244 2\342\200\2233 alasivulla."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  3. **Skin Library**: Valmiit ja asennettavat kokemuskuoret lupavaatimuksineen."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  4. **Activity & Devices**: Tapahtumahistoria, ehdotukset ja N valtuutetun laitteen hallinta."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Tablet / Desktop (> 768px)**: Mukautuva monipalstainen asettelu, jossa vasen sivupalkki ja laaja ty\303\266tila hy\303\266dynt\303\244v\303\244t tilaa ilman kapeaa mobiililoukkua."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "### B. Visuaaliset tokenit ja typografia"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **V\303\244rij\303\244rjestelm\303\244 (60-30-10)**:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Tausta (60%)*: Slate 50 / Slate 950 (puhdas, luettava neutraali pinta)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Pinnat & Kortit (30%)*: Valkoinen / Slate 900 ohuilla hiusrajareunuksilla (`border-slate-200 / border-slate-800`)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - *Aksentit (10%)*: Indigonsininen (`#4f46e5`) ja Teal (`#0d9488`) prim\303\244\303\244ritoimintoihin ja hyv\303\244ksynt\303\244painikkeisiin."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Typografia**: Otsikot Plus Jakarta Sans, leip\303\244teksti Manrope, numeeriset kent\303\244t ja tilakoodit `tabular-nums font-mono`."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Anti-Slop -s\303\244\303\244nn\303\266t**: Ei staattisia pillerilaatikkorykelmi\303\244, ei feikkej\303\244 syketikereit\303\244, ei koodikommenttiotsikoita (`// 01_CORE`), vaan aitoa selke\303\244\303\244 otsikointia ja WCAG AA -kontrastia."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }

      thinking_signature: "\022\220\v\n\215\v\001i\024}\023\020\233\020y!\345\210\021=\177a\253\264\325\313d\032\324~\020\242X\252\a\325I\337lD\3655\336\362\234wp\t\265\213\223S\260\224]O\326\225\244\a\215\334\202|@>$a\264Vd\314\034\345\232\226\201\377V\030\322\027\306\267\333\267W\353\017\f4\005\324\355\357\304GY\321\233\331\2146\036\224)V\344%\345\232^\374\2464*\\\0267\346\266\241s\233H\3254\320a~\225\273M\351\\\316\\\3006S\264]c8\016H\326\357\003DMROC\244\345\fTLU\033\206\301J\204\346\337h\240\315n3\215:\247F\302h!\245w?\243{#]#\352\317\037N\177A\201\315\333\320N\305G#\273\026=\356\024\270\213Q\333\267\312\350}\033\251\256\006\361\355\t\201]\340\214\005\2743\364\217\233\273<\233\360\376+\213\371\225\021@\267\245\240S.\f\01768\232\252\001Y\303\237\001yy\3041\333n\204\240o\3426\334\264?\341m%\3777;\"H\265#\373\377\021\2322\3259z\365\306\266\212 <\354\334\273\353A\247zr\bP\270\343S\\\031\275z=nu\320\255\243\357\362\222=\r\3766\261\235\035j\365m\346\333^\337\252\231\370\352\275\030\037\026}c$\364\305\bW\270\327\311O\360`&\352p\346\353V\205M\233\300l\220\35437\2379<\230\311\337\3071\300\340@\206\232\352\035~\022FE\270\253W\327\243\345W\363\256\336\330\232Y\263\254\374\001\205\202t^\234\210\r\306\024\2077\274\227\236\274\000P\337yl\310\345\235\213\272\346&l\037oh\261g~\237M\274r\030*\376\031\034\003\334\251?}ui\025\353\'\260\377<\273\023e\026\002\243\276\352\fw\263l\026\221\022\217\354\316\233[Sl(\031G2\177v\270\320\346\t\240\023\315\202\211\017(\266\273\251\342\350-\026^1G\207\016)\320R\342\347\370\342\035w\331m-Uj;\347\253KL\251\247\017\025\005\246\016\006\240\250|c\225\213Qj\264\231H\327)G\027\t\262\372\214\000V\327\255\211x\352\v\313\245A\241\026\357\275\205E\375\021\364\351V\351\366pk\262\315Q\317T\312w\255\361\350\374\323\372\342G%\241x\345\326\251\264I\271\352R\024\001U\004p\322\274\320U\222\312G\346\247\373\206\262kj\246\362\272?\265xi0_\021\271\212w\017\370\342\241I\016D\307P\346NN\347\245\t\002\376\3647b\347\261\2745]\032|j\240?\005\275\230r\342K>\267~\250\31
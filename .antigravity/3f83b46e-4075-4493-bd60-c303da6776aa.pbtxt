            lines {
              text: "## 1. Yleiskatsaus: Google Stitch vs. Google AI Studio"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Mik\303\244 on Google Stitch?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Google Stitch** on Googlen teko\303\244lypohjainen UI-suunnitteluty\303\266kalu, jonka tavoitteena on nopeuttaa k\303\244ytt\303\266liittymien ideointia:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - K\303\244ytt\303\244j\303\244 kuvailee toivotun n\303\244kym\303\244n luonnollisella kielell\303\244 tai lataa referenssikuvan/luonnoksen."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Stitch tuottaa k\303\244ytt\303\266liittym\303\244sommittelun, v\303\244riteemat ja komponenttirakenteen."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Roolijako (Build Briefin mukaisesti):**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  > *\"Google Stitch can help design; it is not the product runtime.\"*"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Stitch on **suunnittelu- ja ideointity\303\266kalu (Design-to-Prototype)**. Se ei toimi valmiina tuotantoymp\303\244rist\303\266n\303\244 tai tietokantana."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - **Google AI Studio** puolestaan on **toteutus- ja ajoymp\303\244rist\303\266**, jossa koodi (React + TypeScript + Tailwind) el\303\244\303\244, suoritetaan, testataan ja yhdistet\303\244\303\244n oikeisiin API-rajapintoihin."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Ty\303\266nkulkumalli (The Optimal Workflow)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
